{
  "name": "brokerdesk-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright tests for a mock broker trading desk",
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "k6": "k6 run k6/load-trades.js",
    "demo:video": "playwright test -c scripts/broker-demo.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
